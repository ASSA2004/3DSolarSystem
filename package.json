{
  "name": "orbit-solar-observatory",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "test:recovery": "node tests/recovery.mjs",
    "lint": "eslint .",
    "format": "prettier --write src css index.html tests",
    "format:check": "prettier --check src css index.html tests"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
